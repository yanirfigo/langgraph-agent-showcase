[Unit]
Description=Job Copilot run: ingest, screen, research, Telegram digest
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/job-copilot
ExecStart=%h/job-copilot/.venv/bin/python -m job_copilot.run
RuntimeMaxSec=1800

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/job-copilot
PrivateTmp=yes
RestrictSUIDSGID=yes
LockPersonality=yes
UMask=0077
MemoryMax=1G
Nice=10
