[Unit]
Description=Job Copilot: promote owner decisions to the LangSmith dataset fit-labels-live
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/job-copilot
ExecStart=%h/job-copilot/.venv/bin/python evals/promote_feedback.py
RuntimeMaxSec=600

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/job-copilot
PrivateTmp=yes
RestrictSUIDSGID=yes
LockPersonality=yes
UMask=0077
MemoryMax=1G
