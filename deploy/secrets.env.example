# Copy to ~/.config/job-copilot/secrets.env on the host (service user), then: chmod 600
# Never commit the real file. Never export these in a shell profile or a systemd Environment= line.

# Anthropic Console key, ideally in a dedicated workspace with a spend limit.
ANTHROPIC_API_KEY=

# LangSmith (optional: without it the agent runs with tracing off)
LANGSMITH_API_KEY=

# A Telegram bot created for this agent with @BotFather, and the owner's private chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
